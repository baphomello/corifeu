{
  "permissions": {
    "allow": [
      "Bash(python3 .orchestra/scripts/code.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 .orchestra/hooks/guard-src.py" }
        ]
      }
    ]
  }
}
